#!/usr/bin/env python3
"""Pull verified daily Kuni backups; Python stdlib plus the system ssh/scp clients.

Required flags (or matching KUNI_BACKUP_* variables): --host / HOST, --key / KEY,
--remote-root / REMOTE_ROOT, --remote-dir / REMOTE_DIR. Optional: --remote-python /
REMOTE_PYTHON (default REMOTE_ROOT/.venv/bin/python), --local-dir / LOCAL_DIR
(default ~/Backups/kuni). Remote paths must be absolute; ~ is not expanded.
The remote backup directory must use only letters, digits, '.', '_', '/', '-'
so even legacy scp cannot expand it as a shell expression. Key paths may contain spaces.
Archives contain credentials and are not encrypted. Run as the local backup owner.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import shlex
import subprocess
import sys
import tempfile


ARCHIVE_NAME = re.compile(r"kuni-backup-[0-9]{8}T[0-9]{6}Z\.tar\.gz\Z")


def _remote_path(value: str) -> PurePosixPath:
    path = PurePosixPath(value)
    if not path.is_absolute() or ".." in path.parts or any(c in value for c in "\r\n\0"):
        raise ValueError("Remote paths must be absolute and contain no '..' or control characters")
    return path


def _matches(path: Path, size: int, digest: str) -> bool:
    if path.is_symlink() or not path.is_file() or path.stat().st_size != size:
        return False
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest() == digest


def pull(args: argparse.Namespace) -> Path:
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.@:\[\]-]*", args.host):
        raise ValueError("Invalid SSH host")
    root, remote_dir = _remote_path(args.remote_root), _remote_path(args.remote_dir)
    if not re.fullmatch(r"/[A-Za-z0-9_./-]+", str(remote_dir)):
        raise ValueError("Remote backup directory contains unsafe scp characters")
    python = _remote_path(args.remote_python) if args.remote_python else root / ".venv/bin/python"
    key = Path(args.key).expanduser().resolve(strict=True)
    if not key.is_file():
        raise ValueError("SSH key must be a file")
    local_dir = Path(args.local_dir).expanduser().resolve()
    if local_dir == Path(local_dir.anchor):
        raise ValueError("Use a dedicated local backup directory, not the filesystem root")
    local_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    local_dir.chmod(0o700)
    options = ["-i", str(key), "-o", "IdentitiesOnly=yes", "-o", "StrictHostKeyChecking=yes",
               "-o", "BatchMode=yes", "-o", "ConnectTimeout=15"]
    command = (f"cd -- {shlex.quote(str(root))} && exec {shlex.quote(str(python))} -m kuni.backup "
               f"--source {shlex.quote(str(root))} --destination {shlex.quote(str(remote_dir))}")
    fd = os.open(local_dir / ".pull.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "a+b") as lock:
        os.fchmod(lock.fileno(), 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        result = subprocess.run(["ssh", *options, "--", args.host, command], check=True,
                                capture_output=True, text=True, timeout=600)
        info = json.loads(result.stdout)
        if (not isinstance(info, dict) or not isinstance(info.get("path"), str)
                or type(info.get("size")) is not int or info["size"] <= 0
                or not isinstance(info.get("sha256"), str)
                or not re.fullmatch(r"[a-f0-9]{64}", info["sha256"])):
            raise ValueError("Invalid remote archive metadata")
        remote = _remote_path(info["path"])
        if remote.parent != remote_dir or not ARCHIVE_NAME.fullmatch(remote.name):
            raise ValueError("Remote archive is not in the configured backup directory")
        target = local_dir / remote.name
        if not _matches(target, info["size"], info["sha256"]):
            with tempfile.TemporaryDirectory(prefix=".kuni-pull-", dir=local_dir) as temporary:
                partial = Path(temporary) / (remote.name + ".partial")
                partial.touch(mode=0o600)
                subprocess.run(["scp", *options, "--", f"{args.host}:{remote}", str(partial)],
                               check=True, capture_output=True, timeout=600)
                if not _matches(partial, info["size"], info["sha256"]):
                    raise ValueError("Downloaded archive size/checksum mismatch")
                partial.chmod(0o600)
                with partial.open("rb") as stream:
                    os.fsync(stream.fileno())
                os.replace(partial, target)
                directory_fd = os.open(local_dir, os.O_RDONLY | os.O_DIRECTORY)
                try:
                    os.fsync(directory_fd)
                finally:
                    os.close(directory_fd)
        target.chmod(0o600)
        archives = sorted(path for path in local_dir.iterdir()
                          if path != target and ARCHIVE_NAME.fullmatch(path.name)
                          and not path.is_symlink() and path.is_file())
        for old in archives[:-29]:
            old.unlink()
        return target


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ("host", "key", "remote-root", "remote-dir"):
        default = os.environ.get("KUNI_BACKUP_" + name.replace("-", "_").upper())
        parser.add_argument("--" + name, default=default, required=not bool(default))
    parser.add_argument("--remote-python", default=os.environ.get("KUNI_BACKUP_REMOTE_PYTHON"))
    parser.add_argument("--local-dir", default=os.environ.get("KUNI_BACKUP_LOCAL_DIR", str(Path.home() / "Backups/kuni")))
    args = parser.parse_args()
    os.umask(0o077)
    try:
        print(pull(args))
    except Exception as exc:
        print(f"kuni backup pull failed ({type(exc).__name__})", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
